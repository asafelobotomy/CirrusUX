# /etc/cloud64-panel/gateway.env on cloud-box — mode 600, owner c64panel.
C64_LISTEN=127.0.0.1:8064
C64_DATA_DIR=/var/lib/c64panel
# Tailscale logins allowed to use the panel (comma-separated).
C64_ALLOWED_USERS=<your tailscale login>
# 32+ random characters, e.g. `openssl rand -hex 32`. Same value on cloud64.
C64_AGENT_TOKEN=<set in env>
C64_TAILSCALE_PEER=cloud64
# The wake wrapper runs the admin user's cloud64-wake with the router
# password from /etc/cloud64-panel/router.env; see c64panel-wake.
C64_WAKE_CMD=sudo -n /usr/local/sbin/c64panel-wake
# Optional: append actions to the admin box's changelog (needs group write).
#C64_CHANGELOG=/workspace/cloud64/CHANGELOG.md

# Grok. Without these the panel works and Grok says it isn't set up.
#XAI_API_KEY=<set in env>
#XAI_MODEL=<model name from the xAI console>
#C64_GROK_DAILY_TOKENS=200000
