# /etc/cirrusux/gateway.env on cloud-box — mode 600, owner cirrusux.
CIRRUS_LISTEN=127.0.0.1:8064
CIRRUS_DATA_DIR=/var/lib/cirrusux
# Tailscale logins allowed to use the panel (comma-separated).
CIRRUS_ALLOWED_USERS=<your tailscale login>
# 32+ random characters, e.g. `openssl rand -hex 32`. Same value on cloud64.
CIRRUS_AGENT_TOKEN=<set in env>
CIRRUS_TAILSCALE_PEER=cloud64
# The wake wrapper runs the admin user's cloud64-wake with the router
# password from /etc/cirrusux/router.env; see cirrusux-wake.
CIRRUS_WAKE_CMD=sudo -n /usr/local/sbin/cirrusux-wake
# Optional: append actions to the admin box's changelog (needs group write).
#CIRRUS_CHANGELOG=/workspace/cloud64/CHANGELOG.md

# Grok. Without these the panel works and Grok says it isn't set up.
#XAI_API_KEY=<set in env>
#XAI_MODEL=<model name from the xAI console>
#CIRRUS_GROK_DAILY_TOKENS=200000
