# /etc/cirrusux/host.env — settings for cirrusux-setup. Owner root, mode
# 644 or 600: setup runs as root and refuses a file anyone else can change.
# Run `sudo cirrusux-setup check` to see what would change before `apply`.

# Modules run when none are named on the command line, in this order.
HOST_MODULES="base cirrusux"

# base
HOST_TZ=Europe/London
HOST_AUTO_UPDATES=no

# cirrusux: single (gateway and agent here), server or gateway (split setup).
CIRRUS_ROLE=single
CIRRUS_ACTIONS=yes
#CIRRUS_SERVER_NAME=homeserver
#CIRRUS_ALLOWED_USERS=you@example.com
#CIRRUS_RELEASE=/opt/cirrusux

# network: Wake-on-LAN that survives reboots (empty skips it), and a check
# that Tailscale starts at boot and is logged in.
#NET_WOL_IFACE=enp1s0
#NET_TAILSCALE=yes

# backup: age-encrypted system backups on a timer. Make the key pair on
# another machine (age-keygen) and put only the public key here.
#BACKUP_AGE_RECIPIENT=age1...
#BACKUP_DIR=/srv/backups
#BACKUP_PATHS="/etc /root /home /usr/local /var/lib/cirrusux /srv/cirrusux"
#BACKUP_EXCLUDE=""
#BACKUP_SCHEDULE="*-*-* 03:30"
#BACKUP_KEEP=7

# security: fail2ban for SSH and a weekly virus scan.
#SEC_FAIL2BAN=yes
#SEC_AV=yes
#SEC_AV_PATHS="/home /srv /usr/local /tmp /var/tmp"
#SEC_AV_SCHEDULE="Sun *-*-* 04:00"

# firewall (add it to HOST_MODULES when ready). LAN and tailnet only; a new
# ruleset rolls back by itself unless you run `cirrusux-setup firewall-confirm`.
#FIREWALL_ALLOW="192.168.1.0/24"
#FIREWALL_TAILSCALE=yes
#FIREWALL_PUBLIC_TCP=""
#FIREWALL_CONFIRM_SECONDS=120
