# /etc/systemd/system/cirrusux-dockerfilter.service on cloud64
[Unit]
Description=Docker API filter for the CirrusUX agent (reads, start/stop/restart)
Requires=cirrusux-dockerfilter.socket
After=docker.service

[Service]
ExecStart=/usr/local/sbin/cirrusux-dockerfilter
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ReadWritePaths=/run/docker.sock
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
