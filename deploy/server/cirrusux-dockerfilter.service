# /etc/systemd/system/cirrusux-dockerfilter.service on the server
[Unit]
Description=Docker API filter for the CirrusUX agent (reads, start/stop/restart)
Requires=cirrusux-dockerfilter.socket
After=docker.service

[Service]
ExecStart=/usr/local/sbin/cirrusux-dockerfilter
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
# "-": a server without Docker (Podman, or no containers yet) can still start it.
ReadWritePaths=-/run/docker.sock
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
