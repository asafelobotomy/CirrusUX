# /etc/cirrusux/agent.env on the server — mode 600, owner cirrusux.
# Single setup: http://127.0.0.1:8064/agent/snapshot. Split setup: the
# gateway's tailnet address, e.g. https://gateway.<tailnet>.ts.net/agent/snapshot
CIRRUS_GATEWAY_URL=http://127.0.0.1:8064/agent/snapshot
# Same value as CIRRUS_AGENT_TOKEN in the gateway's env file.
CIRRUS_AGENT_TOKEN=<set in env>
# File system the disk widget shows.
#CIRRUS_DISK=/
# Sleep module: the idle checker's config (IDLE_MIN, GRACE_MIN, WAKE_TIMERS).
#CIRRUS_IDLE_CONF=
# Names for ports in the idle checker's activity reasons.
#CIRRUS_PORT_NAMES=8080=Proxy
