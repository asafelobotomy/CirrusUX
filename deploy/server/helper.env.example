# /etc/cirrusux/helper.env on the server — owner root, mode 644 or 600:
# the helper runs as root and refuses a file anyone else can change.
# Each module is optional; leave its settings out to switch it off.
# Without any, the panel still shows containers, disk and temperature.

# Sleep: an idle checker that suspends the server, and stay-awake holds.
#IDLE_STATE_DIR=/run/idle-check
#IDLE_LOG=/var/log/idle-check.log
#STAY_AWAKE_FILE=/run/stay-awake
#STAY_AWAKE_BIN=/usr/local/bin/stay-awake
#ALLOW_SLEEP_BIN=/usr/local/bin/allow-sleep

# Backups: the systemd unit that makes them and where archives land.
#BACKUP_UNIT=system-backup.service
#BACKUP_DIR=/srv/backups
#BACKUP_PREFIX=system-

# Security.
#AV_LOG=/var/log/clamav/scan.log
#FAIL2BAN_JAIL=sshd
# Space-separated CHAIN:pattern checks: passes when `iptables -S CHAIN`
# contains the pattern.
#FIREWALL_CHECKS=DOCKER-USER:DROP
#EGRESS_REPORT=/usr/local/sbin/egress-report.sh
