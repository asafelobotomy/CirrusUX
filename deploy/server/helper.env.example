# /etc/cirrusux/helper.env on the server — owner root, mode 644 or 600:
# the helper runs as root and refuses a file anyone else can change.
#
# cirrusux-setup's modules write their own settings to
# /etc/cirrusux/helper.d/*.env, read after this file: a later file's value
# wins (firewall checks, media and storage roots add up). Set things here
# only for what the modules don't do, or for scripts of your own.
# Each module is optional; leave its settings out to switch it off.
# Without any, the panel still shows containers, disk and temperature.
# Every setting is in docs/CONFIG.md.

# Sleep (the sleep module writes these): the idle checker's state and log,
# and the stay-awake commands.
#IDLE_STATE_DIR=/run/cirrusux-idle
#IDLE_LOG=/var/log/cirrusux-idle.log
#STAY_AWAKE_FILE=/run/cirrusux-idle/hold
#STAY_AWAKE_BIN=/usr/local/sbin/cirrusux-stay-awake
#ALLOW_SLEEP_BIN=/usr/local/sbin/cirrusux-allow-sleep

# Backups (the backup module writes these): the unit that makes them and
# where archives land.
#BACKUP_UNIT=cirrusux-backup.service
#BACKUP_DIR=/srv/backups
#BACKUP_PREFIX=homeserver-system-

# Security (the security and firewall modules write these).
#AV_LOG=/var/log/cirrusux/av-scan.log
#FAIL2BAN_JAIL=sshd
# Space-separated checks: CHAIN:pattern passes when `iptables -S CHAIN`
# contains the pattern; family/table/chain:pattern when `nft list chain`
# does, e.g. inet/cirrusux/input:drop.
#FIREWALL_CHECKS=inet/cirrusux/input:drop
# An outbound-traffic report script of your own.
#EGRESS_REPORT=/usr/local/sbin/egress-report
