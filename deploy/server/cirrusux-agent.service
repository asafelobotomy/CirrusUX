# /etc/systemd/system/cirrusux-agent.service on the server
[Unit]
Description=CirrusUX agent (pushes snapshots to the gateway)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
User=cirrusux
Group=cirrusux
EnvironmentFile=/etc/cirrusux/agent.env
ExecStart=/usr/local/bin/cirrusux-agent
Restart=on-failure
RestartSec=30s
Nice=10
# The agent calls the helper through sudo, so NoNewPrivileges and capability
# limits would break it; keep the filesystem protections that don't.
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
