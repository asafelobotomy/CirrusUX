# /etc/systemd/system/cirrusux-dockerfilter.socket on the server
[Unit]
Description=Filtered Docker API socket for the CirrusUX agent

[Socket]
ListenStream=/run/cirrusux/docker.sock
SocketUser=root
SocketGroup=cirrusux
SocketMode=0660
# The folder systemd makes for the socket belongs to root, so the agent
# must be able to pass through it; the socket's own mode keeps others out.
DirectoryMode=0755

[Install]
WantedBy=sockets.target
