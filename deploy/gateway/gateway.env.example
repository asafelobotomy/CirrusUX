# /etc/cirrusux/gateway.env — mode 600, owner cirrusux. Every setting is
# described in docs/CONFIG.md.
CIRRUS_LISTEN=127.0.0.1:8064
CIRRUS_DATA_DIR=/var/lib/cirrusux-gateway
# 32+ random characters, e.g. `openssl rand -hex 32`. Same value in agent.env.
CIRRUS_AGENT_TOKEN=<set in env>

# What the panel manages.
CIRRUS_SERVER_NAME=homeserver
# Where its apps open, if not the name above (a MagicDNS name or address).
#CIRRUS_SERVER_HOST=homeserver
# single: the gateway runs on the server, which doesn't sleep.
# split: the server sleeps and the gateway runs on an always-on machine.
CIRRUS_SETUP=single
# Time zone for every time shown; defaults to this machine's.
#CIRRUS_TZ=Europe/London
# A sentence for the assistant about what the server is and runs.
#CIRRUS_SERVER_ABOUT=A home media server running Jellyfin and Navidrome.

# Sign-in. tailscale: `tailscale serve` in front, logins below are
# Tailscale logins. header: a reverse proxy that has already signed the
# user in (Authelia, Authentik, oauth2-proxy) sets CIRRUS_AUTH_HEADER.
CIRRUS_AUTH=tailscale
#CIRRUS_AUTH_HEADER=Remote-User
# The identity header is only believed from these addresses.
#CIRRUS_TRUSTED_PROXIES=127.0.0.1,::1
CIRRUS_ALLOWED_USERS=<your login>

# Split setup only: how to wake the server.
#   wol: the gateway sends a magic packet on the LAN (needs to be on the
#        server's LAN, and Wake-on-LAN enabled on its network card).
#   command: runs CIRRUS_WAKE_CMD (argv, no shell), e.g. the router wake:
#        sudo -n /usr/local/sbin/cirrusux-router-wake (deploy/gateway).
#CIRRUS_WAKE=wol
#CIRRUS_WAKE_MAC=<server's MAC address>
#CIRRUS_WAKE_BROADCAST=255.255.255.255:9
#CIRRUS_WAKE_CMD=
# The server's Tailscale name for awake/asleep (defaults to its name);
# "-" to rely on the agent's reports only.
#CIRRUS_TAILSCALE_PEER=homeserver
# A second opinion on whether it's on: ask the router (TR-064, e.g. a
# FRITZ!Box) through the root-only wrapper in deploy/gateway, which keeps
# the router password away from the gateway.
#CIRRUS_POWER_CHECK_CMD=sudo -n /usr/local/sbin/cirrusux-router-check
#CIRRUS_POWER_CHECK_SECS=60

# Optional: also append every action to this Markdown file.
#CIRRUS_CHANGELOG=

# The assistant: any OpenAI-compatible chat API. Without a model the panel
# works and the assistant says it isn't set up.
#   xai, openai, anthropic: hosted, need ASSISTANT_API_KEY
#   ollama: a local model, no key
#   custom: set ASSISTANT_BASE_URL
#ASSISTANT_PROVIDER=xai
#ASSISTANT_MODEL=<model name>
#ASSISTANT_API_KEY=<set in env>
#ASSISTANT_BASE_URL=
#ASSISTANT_NAME=
#CIRRUS_ASSISTANT_DAILY_TOKENS=200000
# Let the 08:00 digest ask the assistant for a written summary. Off by
# default, so the assistant is only called when you use it.
#CIRRUS_DIGEST_ASSISTANT=1
