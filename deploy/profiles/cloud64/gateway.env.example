# cloud64 profile: /etc/cirrusux/gateway.env on cloud-box — owner cirrusux,
# mode 600. Names and comments only: fill the values in on the machine.
# cloud-box has no systemd: runit starts the gateway, which reads this file
# itself (-env), the way systemd would. Settings: docs/CONFIG.md.

CIRRUS_LISTEN=
CIRRUS_DATA_DIR=
# The same 64 hex characters as agent.env's (head -c 32 /dev/urandom | od -An -tx1).
CIRRUS_AGENT_TOKEN=

CIRRUS_SERVER_NAME=
CIRRUS_GATEWAY_NAME=
# split: cloud64 sleeps, cloud-box answers for it.
CIRRUS_SETUP=
CIRRUS_TZ=
CIRRUS_SERVER_ABOUT=

# tailscale: `tailscale serve` (userspace mode) passes the login.
CIRRUS_AUTH=
CIRRUS_ALLOWED_USERS=

# The router wakes cloud64 and tells whether it's on the network, through
# the SOCKS5 tunnel (ROUTER_PROXY in /etc/cirrusux/router.env):
#   CIRRUS_WAKE=command
#   CIRRUS_WAKE_CMD=sudo -n /usr/local/sbin/cirrusux-router-wake
#   CIRRUS_POWER_CHECK_CMD=sudo -n /usr/local/sbin/cirrusux-router-check
CIRRUS_WAKE=
CIRRUS_WAKE_CMD=
CIRRUS_POWER_CHECK_CMD=
# cloud64's Tailscale name, for awake or asleep.
CIRRUS_TAILSCALE_PEER=

# The assistant (xai), off until a model and key are set.
ASSISTANT_PROVIDER=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
CIRRUS_DIGEST_ASSISTANT=
