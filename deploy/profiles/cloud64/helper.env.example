# cloud64 profile: /etc/cirrusux/helper.env on cloud64 — root:root, mode 644.
# Names and comments only. After the reinstall the modules write their own
# settings to /etc/cirrusux/helper.d/ (sleep, backup, security, firewall,
# apps), so this file only holds what no module covers yet.

# Until CirrusUX logs outgoing traffic itself, the captured egress report:
# install it from the capture as /usr/local/sbin/egress-report.sh (root,
# mode 755) and name it here.
EGRESS_REPORT=
