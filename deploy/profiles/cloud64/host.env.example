# cloud64 profile: /etc/cirrusux/host.env on cloud64 — root:root, mode 600.
# Names and comments only: fill the values in on the machine, never here.
# Every setting is described in docs/CONFIG.md.

# All of cloud64's modules, in order. Add firewall and ssh last, from a
# session that will still be allowed in (each rolls back unless confirmed).
HOST_MODULES=
#   base cirrusux network backup security apps sleep firewall ssh ftps

# base: the UK time zone; apt's automatic upgrades off.
HOST_TZ=
HOST_AUTO_UPDATES=

# cirrusux: the server side of the split setup (role "server").
CIRRUS_ROLE=
CIRRUS_SERVER_NAME=
CIRRUS_RELEASE=

# network: the wired card that wakes on a magic packet (`ip link`), and
# Tailscale's preferences as they were before the reinstall (the capture
# has them: `tailscale debug prefs`).
NET_WOL_IFACE=
NET_TAILSCALE_SET=
NET_TAILSCALED_FLAGS=

# backup: to the media disk, two weeks kept; refuses to run without the disk.
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=
BACKUP_REQUIRE_MOUNT=
BACKUP_KEEP=

# security: fail2ban never bans loopback or the tailnet.
SEC_FAIL2BAN_IGNOREIP=
SEC_FAIL2BAN_BANTIME=
SEC_FAIL2BAN_FINDTIME=
SEC_FAIL2BAN_MAXRETRY=

# apps: Podman; the media disk is where media may be chosen from; apps
# write as the media's existing owner (`ls -ln` on the media disk), so
# nothing needs a chown.
APPS_RUNTIME=
APPS_MEDIA_ROOTS=
APPS_MEDIA_UID=
APPS_MEDIA_GID=

# sleep: as the old idle check did. The TV is ignored unless it streams
# (MB a minute), and a wake only it used ends after a few minutes.
SLEEP_IDLE_MIN=
SLEEP_GRACE_MIN=
SLEEP_IGNORE_CLIENTS=
SLEEP_IGNORE_CLIENTS_PLAY_MB=
SLEEP_IGNORE_WAKE_GRACE_MIN=
SLEEP_RESUME_FIXES=
# The USB controller's PCI address (`lspci -D`), which woke it for nothing.
SLEEP_NO_WAKEUP_DEVICES=

# firewall: the LAN, plus the tailnet.
FIREWALL_ALLOW=

# ssh: the admin login from the LAN and the tailnet. Password logins stay on.
SSH_ALLOW=

# ftps: one user, landing in the media disk. Its password is never written
# anywhere of ours: `sudo cirrusux-setup ftps-passwd` asks for it.
FTPS_USER=
FTPS_HOME=
FTPS_PASSIVE_PORTS=
