# cloud64 profile: /etc/cirrusux/agent.env on cloud64 — owner cirrusux,
# mode 600. Names and comments only: fill the values in on the machine.
# cirrusux-setup creates the file; these are the values to set in it.

# https://<cloud-box's tailnet name>/agent/snapshot
CIRRUS_GATEWAY_URL=
# The same token as gateway.env's.
CIRRUS_AGENT_TOKEN=
# The media disk's mount point: the disk widget shows it.
CIRRUS_DISK=
# The sleep module's config (the default, /etc/cirrusux/sleep.env, is right).
CIRRUS_IDLE_CONF=
# Names for ports in activity reasons, e.g. Jellyfin's and Navidrome's.
CIRRUS_PORT_NAMES=
